{
  "schema_version": 1,
  "rules": [
    {
      "id": "PS04-GTFO-SUDO-FIND-EXEC-SHELL",
      "title": "Sudo find executing a bare shell",
      "status": "test",
      "description": "find -exec straight into a shell with no script, the GTFOBins escape from a sudo rule that allows find.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "\\bfind\\b[^|;&]*\\s-exec(?:dir)?\\s+(?:\\S*/)?(?:ba|da|z|k)?sh(?:\\s+-p)?\\s+(?:;|\\+)"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/find/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-VIM-SHELL",
      "title": "Sudo vim running a shell or interpreter",
      "status": "test",
      "description": "vim started with -c :! or :py/:lua, which runs commands as root before the editor opens.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "\\b(?:vim?|nvim|vim\\.basic|vim\\.tiny|rvim|view)\\b[^|;&]*\\s(?:-c|\\+)\\s*:?\\s*(?:!|(?:py3?|python3?|lua|perl|ruby)\\s)"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/vim/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-TAR-CHECKPOINT",
      "title": "Sudo tar with a checkpoint exec action",
      "status": "test",
      "description": "tar --checkpoint-action=exec runs an arbitrary command as root.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "--checkpoint-action\\s*=?\\s*exec"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/tar/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-ENV-SHELL",
      "title": "Sudo env launching a bare shell",
      "status": "test",
      "description": "env followed by nothing but a shell, the GTFOBins escape from a sudo rule that allows env.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "^(?:\\S*/)?env\\s+(?:-\\S+\\s+|\\w+=\\S*\\s+)*(?:\\S*/)?(?:ba|da|z|k)?sh(?:\\s+-p)?\\s*$"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/env/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-CAPSH",
      "title": "Sudo capsh dropping to a shell",
      "status": "test",
      "description": "capsh -- starts a root shell, optionally after setting uid and gid.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "(?:^|/)capsh(?:\\s+\\S+)*\\s+--(?:\\s|$)"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/capsh/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-AWK-SYSTEM",
      "title": "Sudo awk calling system() on a shell",
      "status": "test",
      "description": "awk BEGIN {system(\"/bin/sh\")} under sudo.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "\\b(?:g|m|n)?awk\\b.*\\bsystem\\s*\\(\\s*[\\\"']?(?:\\S*/)?(?:ba|da|z|k)?sh\\b"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/awk/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-INTERPRETER-SHELL",
      "title": "Sudo interpreter one-liner spawning a shell",
      "status": "test",
      "description": "python, perl, ruby, lua, php or node -c/-e code that execs a shell as root.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
        "all": [
          {
            "field": "log.ident",
            "equals": [
              "sudo"
            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "\\b(?:python[0-9.]*|perl|ruby|lua[0-9.]*|php[0-9.]*|node)\\s+-[cer]\\s.*(?:os\\.system|os\\.exec\\w*|pty\\.spawn|subprocess\\.\\w+|\\bexec\\s*\\(?|\\bsystem\\s*\\(|spawn\\s*\\()[^)]*[\\\"']?/bin/(?:ba|da|z)?sh"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/python/",
        "https://gtfobins.github.io/gtfobins/perl/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-ZIP-TT",
