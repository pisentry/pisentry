          {
            "field": "process.cmdline",
            "regex": [
              "(?:^|/)script\\s+(?:-\\S+\\s+)*/dev/null\\s*$",
              "(?:^|/)script\\s+(?:-\\S+\\s+)*-c\\s+(?:\\S*/)?(?:ba|da|z|k)?sh\\s+/dev/null"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/script/"
      ]
    },
