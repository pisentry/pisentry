            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/gdb/"
      ]
    },
    {
      "id": "PS04-GTFO-SUDO-WRAPPER-SHELL",
      "title": "Sudo wrapper program launching a bare shell",
      "status": "test",
      "description": "strace, timeout, nice, stdbuf, taskset, setarch, flock, unshare, nsenter, busybox, xargs and similar wrappers started with nothing but a shell, the GTFOBins escape from a sudo rule that allows the wrapper.",
      "author": "pisentry",
      "category": "PS04",
      "level": "high",
      "mitre": [
        "T1548.003"
      ],
      "source": "log",
      "match": {
