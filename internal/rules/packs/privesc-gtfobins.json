            ]
          },
          {
            "field": "process.cmdline",
            "regex": [
              "\\s-TT\\s|--unzip-command"
            ]
          }
        ]
      },
      "references": [
        "https://gtfobins.github.io/gtfobins/zip/"
      ]
    },
    {
